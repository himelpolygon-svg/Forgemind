<% pageTitle = meta.label %>
<%- include('../partials/admin-top') %>

<p class="help-text" style="margin-top:0;"><%= meta.help %></p>

<form method="post" action="/admin/section/<%= meta.key %>" enctype="multipart/form-data">
  <div class="card">
    <% rows.forEach(function(row){ %>
      <div class="field">
        <label><%= row.field_key.replace(/_/g,' ').replace(/\b\w/g, c => c.toUpperCase()) %></label>
        <% if (row.field_type === 'image') { %>
          <div class="img-preview">
            <img src="<%= row.value %>" alt="">
            <input type="file" name="<%= row.field_key %>" accept="image/*">
          </div>
        <% } else if (row.field_type === 'richtext') { %>
          <textarea name="<%= row.field_key %>"><%= row.value %></textarea>
        <% } else { %>
          <input type="text" name="<%= row.field_key %>" value="<%= row.value %>">
        <% } %>
      </div>
    <% }); %>
    <% if (!rows.length) { %>
      <p class="empty-state">No fields defined for this section yet.</p>
    <% } %>
  </div>

  <div class="actions-row">
    <button class="btn btn-primary" type="submit">Save changes</button>
    <a href="/admin" class="btn btn-secondary">Cancel</a>
  </div>
</form>

<%- include('../partials/admin-bottom') %>
