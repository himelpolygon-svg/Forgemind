  <footer class="site-footer">
    <div class="footer-glow-l"></div>
    <div class="footer-glow-r"></div>

    <div class="footer-top">
      <div class="footer-top-inner">
        <div class="footer-logo">
          <img src="<%= global.logo %>" alt="ForgeMind - Forging Future Intelligence">
        </div>
        <div class="footer-contact">
          <div class="icon-box"><img src="/icons/icon-phone.svg" alt=""></div>
          <div class="txt">
            <p><%= footer.contact_email %></p>
            <strong><%= footer.contact_phone %></strong>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-main" style="margin-top:50px;">
      <div class="footer-col-social" style="margin-left:200px;">
        <h4>Social Links</h4>
        <div class="social-icons">
          <a href="<%= global.social_facebook_url %>"><img src="/icons/social-facebook.svg" alt="Facebook"></a>
          <a href="<%= global.social_instagram_url %>"><img src="/icons/social-instagram.svg" alt="Instagram"></a>
          <a href="<%= global.social_twitter_url %>"><img src="/icons/social-twitter.svg" alt="Twitter"></a>
        </div>
      </div>
      <div class="footer-cols-wrap" style="margin-right:200px;">
        <div class="footer-col">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="index.html">Home</a></li>
            <li><a href="about.html">About Us</a></li>
            <li><a href="#">Services</a></li>
            <li><a href="#">Blog</a></li>
            <li><a href="#">Contact Us</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Our Services</h4>
          <ul>
            <% footerServices.forEach(function(s){ %>
              <li><%= s.title %></li>
            <% }); %>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p><%= footer.copyright_text %></p>
    </div>
  </footer>
