    <section class="why">
      <div class="ellipse-left"></div>
      <div class="head">
        <div class="badge">
          <span class="dot"></span>
          <span><%= why.badge_text %></span>
        </div>
        <h2 class="section-heading"><%= why.heading %></h2>
      </div>

      <div class="why-grid">
        <div class="center-glow"></div>
        <div class="why-col">
          <div class="item bordered">
            <img class="icon" src="<%= why.item1_icon %>" alt="">
            <h4><%= why.item1_title %></h4>
            <p><%= why.item1_body %></p>
          </div>
          <div class="item">
            <img class="icon" src="<%= why.item2_icon %>" alt="">
            <h4><%= why.item2_title %></h4>
            <p><%= why.item2_body %></p>
          </div>
        </div>
        <div class="why-center">
          <img src="<%= why.emblem_image %>" alt="ForgeMind emblem">
        </div>
        <div class="why-col">
          <div class="item bordered">
            <img class="icon" src="<%= why.item3_icon %>" alt="">
            <h4><%= why.item3_title %></h4>
            <p><%= why.item3_body %></p>
          </div>
          <div class="item">
            <img class="icon" src="<%= why.item4_icon %>" alt="">
            <h4><%= why.item4_title %></h4>
            <p><%= why.item4_body %></p>
          </div>
        </div>
      </div>
    </section>
